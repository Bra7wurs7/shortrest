{
  "name": "shortrest",
  "version": "0.3.1",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "build-linux": "vite build --minify && cargo build --target x86_64-unknown-linux-gnu --release --features desktop",
    "build-windows": "vite build --minify && cargo build --target x86_64-pc-windows-gnu --release",
    "build-apple": "vite build --minify && cargo build --target aarch64-apple-darwin --release",
    "clean": "rm -rf ./dist",
    "serve": "vite preview"
  },
  "license": "GNU AGPLv3",
  "devDependencies": {
    "license-checker": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-plugin-solid": "^2.11.9"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.12",
    "@lezer/highlight": "^1.0.0",
    "@mistralai/mistralai": "^1.14.1",
    "@types/file-saver": "^2.0.7",
    "boxicons": "^2.1.4",
    "buffer": "^6.0.3",
