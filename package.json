    "memfs": "^4.48.1",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "ollama": "^0.6.0",
    "solid-js": "^1.9.9",
    "uuid": "^11.1.0"
  }
